      "title": "95-й процентиль — успешные переходы",
      "description": "Жёлтый > 50 мс, красный > 150 мс",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: мс",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50   },
              { "color": "red",    "value": 150  }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"urlshortener\", uri=\"/api/v1/{shortCode}\", status=\"302\"}[1m])) by (le)) * 1000",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

