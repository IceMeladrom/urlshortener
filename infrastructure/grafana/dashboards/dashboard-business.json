{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Аннотации и оповещения",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Обзор", "url": "/d/urlshortener-overview", "type": "link", "targetBlank": false },
    { "title": "Запросы", "url": "/d/urlshortener-http", "type": "link", "targetBlank": false },
    { "title": "Инфраструктура", "url": "/d/urlshortener-infra", "type": "link", "targetBlank": false }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Текущее состояние",
      "type": "row"
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "type": "stat",
      "title": "Доля попаданий в Redis",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(cache_hit_total{application=\"urlshortener\"}[1m])) / clamp_min(sum(rate(cache_hit_total{application=\"urlshortener\"}[1m])) + sum(rate(cache_miss_total{application=\"urlshortener\"}[1m])), 0.000001) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "type": "stat",
      "title": "Доступность Redis",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Недоступен", "color": "red" },
                "1": { "text": "Доступен", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "redis_available{application=\"urlshortener\"}", "instant": true, "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "type": "stat",
      "title": "Ошибки Redis за секунду",
      "fieldConfig": { "defaults": { "unit": "suffix: ошибок/с" }, "overrides": [] },
      "targets": [
        { "expr": "rate(redis_errors_total{application=\"urlshortener\"}[1m])", "instant": true, "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "type": "stat",
      "title": "Успешные переходы за секунду",
      "fieldConfig": { "defaults": { "unit": "suffix: переходов/с" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"urlshortener\", uri=\"/api/v1/{shortCode}\", status=\"302\"}[1m]))", "instant": true, "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "title": "Накопление и пакетная запись",
      "type": "row"
    },
    {
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "type": "timeseries",
      "title": "Размер накопителей",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "link_click_buffer_size{application=\"urlshortener\"}", "legendFormat": "переходы", "refId": "A" },
        { "expr": "link_expiry_buffer_size{application=\"urlshortener\"}", "legendFormat": "продление срока", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "type": "timeseries",
      "title": "Запись накопленных данных за секунду",
      "fieldConfig": { "defaults": { "unit": "suffix: записей/с" }, "overrides": [] },
      "targets": [
        { "expr": "rate(link_click_flushed_total{application=\"urlshortener\"}[1m])", "legendFormat": "переходы", "refId": "A" },
        { "expr": "rate(link_expiry_flushed_total{application=\"urlshortener\"}[1m])", "legendFormat": "продления срока", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "type": "timeseries",
      "title": "Ошибки записи накопленных данных",
      "fieldConfig": { "defaults": { "unit": "suffix: ошибок/с" }, "overrides": [] },
      "targets": [
        { "expr": "rate(link_buffer_flush_errors_total{application=\"urlshortener\"}[1m])", "legendFormat": "ошибки", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "type": "timeseries",
      "title": "95-й процентиль длительности записи",
      "fieldConfig": { "defaults": { "unit": "suffix: мс" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(link_buffer_flush_duration_seconds_bucket{application=\"urlshortener\"}[1m])) by (le)) * 1000",
          "legendFormat": "95-й процентиль",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["короткие-ссылки"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Сервис коротких ссылок — прикладные метрики",
  "uid": "urlshortener-business",
  "version": 2
}
