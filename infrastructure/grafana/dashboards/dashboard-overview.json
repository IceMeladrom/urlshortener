{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Аннотации и оповещения",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Запросы",
      "url": "/d/urlshortener-http",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Прикладные метрики",
      "url": "/d/urlshortener-business",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Инфраструктура",
      "url": "/d/urlshortener-infra",
      "type": "link",
      "targetBlank": false
    }
  ],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Общее состояние",
      "type": "row"
    },

    {
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "type": "stat",
      "title": "Время работы",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: с",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds{application=\"urlshortener\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "background"
      }
    },

    {
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "type": "stat",
      "title": "Состояние Redis",
      "description": "1 = доступен, 0 = недоступен",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 0.9  }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Недоступен", "color": "red" },
                "1": { "text": "Доступен", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_available{application=\"urlshortener\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "background"
      }
    },

    {
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "type": "stat",
      "title": "Процессор приложения",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.5  },
              { "color": "red",    "value": 0.8  }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"urlshortener\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "type": "stat",
      "title": "Использование кучи",
      "description": "Жёлтый > 350 МБ, красный > 460 МБ (из лимита 512 МБ)",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: МБ",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null      },
              { "color": "yellow", "value": 350 },
              { "color": "red",    "value": 460 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"urlshortener\", area=\"heap\"}) / 1024 / 1024",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "type": "stat",
      "title": "Активные потоки JVM",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 60   },
              { "color": "red",    "value": 90   }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"urlshortener\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "id": 7,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "type": "stat",
      "title": "Паузы сборщика мусора",
      "description": "Количество пауз сборщика мусора в секунду. Жёлтый > 5 пауз/с, красный > 15 пауз/с",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: пауз/с",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5    },
              { "color": "red",    "value": 15   }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{application=\"urlshortener\"}[1m])",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "Виртуальная машина Java",
      "type": "row"
    },

    {
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "type": "timeseries",
      "title": "Куча — используется / выделено",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: МБ",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "выделено" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "используется" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"urlshortener\", area=\"heap\"}) / 1024 / 1024",
          "legendFormat": "используется",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{application=\"urlshortener\", area=\"heap\"}) / 1024 / 1024",
          "legendFormat": "выделено",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "type": "timeseries",
      "title": "Процессор приложения",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"urlshortener\"}",
          "legendFormat": "загрузка процессора",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "type": "timeseries",
      "title": "Потоки виртуальной машины Java",
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "активные" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "служебные" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "пиковые" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"urlshortener\"}",
          "legendFormat": "активные",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"urlshortener\"}",
          "legendFormat": "служебные",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"urlshortener\"}",
          "legendFormat": "пиковые",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 14,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "type": "timeseries",
      "title": "Паузы сборщика мусора — 99-й процентиль",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: мс",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket{application=\"urlshortener\"}[1m])) by (le)) * 1000",
          "legendFormat": "99-й процентиль паузы сборщика мусора",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    }

  ],
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["короткие-ссылки", "нагрузочное-тестирование"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Сервис коротких ссылок — обзор",
  "uid": "urlshortener-overview",
  "version": 1
}
