{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Аннотации и оповещения",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Обзор",
      "url": "/d/urlshortener-overview",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Запросы",
      "url": "/d/urlshortener-http",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Прикладные метрики",
      "url": "/d/urlshortener-business",
      "type": "link",
      "targetBlank": false
    }
  ],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Текущее состояние",
      "type": "row"
    },

    {
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "type": "stat",
      "title": "Пул БД — активные соединения",
      "description": "Жёлтый > 15, красный > 18 (из 20 максимум)",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 15   },
              { "color": "red",    "value": 18   }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"urlshortener\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "type": "stat",
      "title": "Пул БД — ожидают соединения",
      "description": "Должно быть 0. Красный > 3",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 3    }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending{application=\"urlshortener\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "type": "stat",
      "title": "Redis — используемая память",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: МБ",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{instance=\"redis-exporter:9121\"} / 1024 / 1024",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "type": "stat",
      "title": "Redis — подключённые клиенты",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_connected_clients{instance=\"redis-exporter:9121\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "Пул соединений к БД",
      "type": "row"
    },

    {
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "type": "timeseries",
      "title": "Пул соединений БД — занятые / свободные / ожидающие",
      "description": "Ожидающие > 0 означает, что потоки ждут соединения: это узкое место БД",
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "занятые" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "свободные" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ожидающие" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"urlshortener\"}",
          "legendFormat": "занятые",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"urlshortener\"}",
          "legendFormat": "свободные",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"urlshortener\"}",
          "legendFormat": "ожидающие",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "type": "timeseries",
      "title": "Пул БД — время ожидания соединения, 95-й процентиль",
      "description": "Время которое поток проводит в очереди ожидания свободного соединения",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: мс",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hikaricp_connections_acquire_seconds_bucket{application=\"urlshortener\"}[1m])) by (le)) * 1000",
          "legendFormat": "95-й процентиль ожидания",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 20,
      "title": "Команды приложения к Redis",
      "type": "row"
    },

    {
      "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "type": "timeseries",
      "title": "Команды Redis со стороны приложения",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: команд/с",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(8, sum by (command) (rate(lettuce_command_completion_seconds_count{application=\"urlshortener\"}[1m])))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 22,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "type": "timeseries",
      "title": "Команды Redis — 95-й процентиль задержки",
      "description": "Время выполнения команд Redis со стороны приложения",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: мс",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lettuce_command_completion_seconds_bucket{application=\"urlshortener\"}[1m])) by (le)) * 1000",
          "legendFormat": "95-й процентиль задержки",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 30,
      "title": "Redis — метрики экспортёра",
      "type": "row"
    },

    {
      "id": 31,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "type": "timeseries",
      "title": "Redis — память используется / предел",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: МБ",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "используется" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "предел" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{instance=\"redis-exporter:9121\"} / 1024 / 1024",
          "legendFormat": "используется",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes{instance=\"redis-exporter:9121\"} / 1024 / 1024",
          "legendFormat": "предел",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 32,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "type": "timeseries",
      "title": "Redis — команды и клиенты",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: команд/с",
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "клиенты" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "short" },
              { "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "команды/с" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total{instance=\"redis-exporter:9121\"}[1m])",
          "legendFormat": "команды/с",
          "refId": "A"
        },
        {
          "expr": "redis_connected_clients{instance=\"redis-exporter:9121\"}",
          "legendFormat": "клиенты",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },

    {
      "id": 33,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "type": "timeseries",
      "title": "Redis — доля успешных чтений",
      "description": "Должна коррелировать с долей попаданий в Redis на дашборде прикладных метрик",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(redis_keyspace_hits_total{instance=\"redis-exporter:9121\"}[1m])) / clamp_min(sum(rate(redis_keyspace_hits_total{instance=\"redis-exporter:9121\"}[1m])) + sum(rate(redis_keyspace_misses_total{instance=\"redis-exporter:9121\"}[1m])), 0.000001) * 100",
          "legendFormat": "доля попаданий, %",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" }
      }
    }

  ],
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["короткие-ссылки", "нагрузочное-тестирование"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Сервис коротких ссылок — инфраструктура",
  "uid": "urlshortener-infra",
  "version": 1
}
